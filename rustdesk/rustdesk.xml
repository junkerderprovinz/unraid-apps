<?xml version="1.0"?>
<Container version="2">
  <Name>RustDesk</Name>
  <Beta>false</Beta>
  <Repository>junkerderprovinz/rustdesk:latest</Repository>
  <Registry>https://hub.docker.com/r/junkerderprovinz/rustdesk</Registry>
  <Network>bridge</Network>
  <Shell>sh</Shell>
  <Privileged>false</Privileged>
  <ReadMe>https://github.com/junkerderprovinz/rustdesk/blob/main/README.md</ReadMe>
  <Support>https://forums.unraid.net/topic/198811-support-junkerderprovinz-unraid-apps/</Support>
  <Project>https://github.com/junkerderprovinz/rustdesk</Project>
  <Overview>
Your own RustDesk server: the ID server and the relay, with a web console, user accounts, an address book that follows you to every client and a web client in the browser. Devices can also change their ID, which the stock open-source server refuses.&#xD;
&#xD;
What you get:&#xD;
• Web console at /_admin/ on port 21114: devices, users, groups, address books, connection and file transfer logs&#xD;
• Log in once in the RustDesk client and your address book is on every device&#xD;
• Web client at /webclient/ for a session from any browser&#xD;
• "Change ID" in the client works, for the machine that registered the old ID and a free new ID&#xD;
• Encrypted connections only, by default&#xD;
&#xD;
Notes:&#xD;
• Fill in the four address fields with the name or IP your clients reach this server under.&#xD;
• The first start creates the key pair in the data folder and prints the console's admin password in the container log (search for "Admin Password").&#xD;
• Moving from another RustDesk server: copy id_ed25519, id_ed25519.pub and db_v2.sqlite3 into the data folder before the first start, and every device keeps its ID.&#xD;
• Clients need the ID server (port 21116), the relay (21117), the API server (http://...:21114) and the key from id_ed25519.pub.&#xD;
&#xD;
Source on GitHub: https://github.com/junkerderprovinz/rustdesk&#xD;
  </Overview>
  <Category>Network:Remote Tools: Productivity:</Category>
  <WebUI>http://[IP]:[PORT:21114]/_admin/</WebUI>
  <TemplateURL>https://raw.githubusercontent.com/junkerderprovinz/unraid-apps/main/rustdesk/rustdesk.xml</TemplateURL>
  <Icon>https://raw.githubusercontent.com/junkerderprovinz/unraid-apps/main/rustdesk/icon.png</Icon>
  <ExtraParams>--restart=unless-stopped</ExtraParams>

  <!-- Ports -->
  <Config Name="Console and web client" Target="21114" Default="21114" Mode="tcp"
          Description="Web console (/_admin/), the API the clients log in to, and the web client (/webclient/). Only needed inside your network unless you want to log in from outside."
          Type="Port" Display="always" Required="true" Mask="false">21114</Config>

  <Config Name="NAT test" Target="21115" Default="21115" Mode="tcp"
          Description="Lets clients find out what kind of NAT they are behind."
          Type="Port" Display="always" Required="true" Mask="false">21115</Config>

  <Config Name="ID server (TCP)" Target="21116" Default="21116" Mode="tcp"
          Description="ID server and hole punching. Forward it if devices outside your network connect."
          Type="Port" Display="always" Required="true" Mask="false">21116</Config>

  <Config Name="ID server (UDP)" Target="21116" Default="21116" Mode="udp"
          Description="ID server registration and hole punching over UDP."
          Type="Port" Display="always" Required="true" Mask="false">21116</Config>

  <Config Name="Relay" Target="21117" Default="21117" Mode="tcp"
          Description="Relay for sessions whose devices cannot reach each other directly."
          Type="Port" Display="always" Required="true" Mask="false">21117</Config>

  <Config Name="ID server (websocket)" Target="21118" Default="21118" Mode="tcp"
          Description="ID server over websocket, used by the web client."
          Type="Port" Display="advanced" Required="false" Mask="false">21118</Config>

  <Config Name="Relay (websocket)" Target="21119" Default="21119" Mode="tcp"
          Description="Relay over websocket, used by the web client."
          Type="Port" Display="advanced" Required="false" Mask="false">21119</Config>

  <!-- Paths -->
  <Config Name="Server data (/data)" Target="/data" Default="/mnt/user/appdata/rustdesk" Mode="rw"
          Description="Key pair (id_ed25519, id_ed25519.pub) and the device database. Keep it: a new key pair means every client has to be set up again."
          Type="Path" Display="always" Required="true" Mask="false">/mnt/user/appdata/rustdesk</Config>

  <Config Name="Console data (/app/data)" Target="/app/data" Default="/mnt/user/appdata/rustdesk/api" Mode="rw"
          Description="Users, groups, address books and logs of the web console."
          Type="Path" Display="always" Required="true" Mask="false">/mnt/user/appdata/rustdesk/api</Config>

  <!-- Addresses the clients use -->
  <Config Name="Relay address (RELAY)" Target="RELAY" Default="" Mode=""
          Description="Name or IP and port of the relay as clients reach it, e.g. rustdesk.example.com:21117."
          Type="Variable" Display="always" Required="true" Mask="false"></Config>

  <Config Name="ID server for clients" Target="RUSTDESK_API_RUSTDESK_ID_SERVER" Default="" Mode=""
          Description="The ID server address the console hands to clients, e.g. rustdesk.example.com:21116."
          Type="Variable" Display="always" Required="true" Mask="false"></Config>

  <Config Name="Relay for clients" Target="RUSTDESK_API_RUSTDESK_RELAY_SERVER" Default="" Mode=""
          Description="The relay address the console hands to clients, e.g. rustdesk.example.com:21117."
          Type="Variable" Display="always" Required="true" Mask="false"></Config>

  <Config Name="API server for clients" Target="RUSTDESK_API_RUSTDESK_API_SERVER" Default="" Mode=""
          Description="The console's address as clients reach it, e.g. http://rustdesk.example.com:21114."
          Type="Variable" Display="always" Required="true" Mask="false"></Config>

  <!-- Behaviour -->
  <Config Name="Encrypted connections only (ENCRYPTED_ONLY)" Target="ENCRYPTED_ONLY" Default="1|0" Mode=""
          Description="1 accepts only clients that know the server's key. 0 also lets clients without the key connect."
          Type="Variable" Display="always" Required="false" Mask="false">1</Config>

  <Config Name="Login required (MUST_LOGIN)" Target="MUST_LOGIN" Default="N|Y" Mode=""
          Description="Y lets only clients that are logged in to the console start a session."
          Type="Variable" Display="always" Required="false" Mask="false">N</Config>

  <Config Name="Console language (RUSTDESK_API_LANG)" Target="RUSTDESK_API_LANG" Default="en|zh-CN|zh-TW|ko|ru|fr|es" Mode=""
          Description="Language of the console's messages."
          Type="Variable" Display="advanced" Required="false" Mask="false">en</Config>

